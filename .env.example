# === APPLICATION ===
NODE_ENV=production
PORT=3000

# === AWS ===
AWS_ACCESS_KEY_ID=ta_access_key
AWS_SECRET_ACCESS_KEY=ta_secret_key
AWS_REGION=eu-west-3

# === EC2 ===
EC2_HOST=ton-ip-ec2.amazonaws.com
EC2_SSH_KEY_PATH=~/.ssh/papier-net-key.pem
